
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">
<title>HZR Football | Official</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg:#090909;
  --panel:#111111;
  --panel2:#151515;
  --red:#ed252d;
  --gold:#d9ae62;
  --text:#f4f4f4;
  --muted:#888;
  --border:#272727;
}

* {
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html { scroll-behavior:smooth; }

body {
  background:var(--bg);
  color:var(--text);
  font-family:Inter,Arial,sans-serif;
  overflow-x:hidden;
}

button { font:inherit; }

a {
  color:inherit;
  text-decoration:none;
}

.container {
  width:min(1120px,92%);
  margin:auto;
}

/* HEADER */

header {
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(9,9,9,.96);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--border);
}

.header-inner {
  min-height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo {
  display:flex;
  align-items:center;
  gap:11px;
  font-family:Orbitron,sans-serif;
  font-size:19px;
  font-weight:800;
  letter-spacing:1px;
  white-space:nowrap;
}

.logo-icon {
  width:39px;
  height:39px;
  display:grid;
  place-items:center;
  background:linear-gradient(145deg,#ed252d,#831016);
  border-radius:11px;
  box-shadow:0 0 18px #ed252d30;
}

.logo-icon svg {
  width:25px;
  height:25px;
}

.logo span { color:var(--red); }

nav {
  display:flex;
  align-items:center;
  gap:5px;
}

.nav-btn {
  color:#aaa;
  background:none;
  border:0;
  padding:12px 13px;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
  transition:.25s;
  border-bottom:2px solid transparent;
}

.nav-btn:hover,
.nav-btn.active {
  color:white;
  border-bottom-color:var(--red);
}

.header-live {
  background:#241012;
  border:1px solid #662126;
  color:#ff6268;
  border-radius:7px;
  padding:9px 12px;
  font-size:10px;
  font-weight:800;
  white-space:nowrap;
}

/* HERO */

.hero {
  position:relative;
  padding:75px 0 65px;
  overflow:hidden;
  border-bottom:1px solid var(--border);
}

.hero::before {
  content:"";
  position:absolute;
  width:400px;
  height:400px;
  border-radius:50%;
  background:#ed252d12;
  filter:blur(90px);
  right:-100px;
  top:-150px;
}

.hero-content {
  position:relative;
  display:grid;
  grid-template-columns:1.3fr .7fr;
  align-items:center;
  gap:35px;
}

.eyebrow {
  color:var(--gold);
  font-size:11px;
  letter-spacing:3px;
  font-weight:800;
  margin-bottom:18px;
}

.hero h1 {
  font-family:Orbitron,sans-serif;
  font-size:clamp(35px,6vw,65px);
  line-height:1.15;
  letter-spacing:-2px;
  margin-bottom:20px;
}

.hero h1 span { color:var(--red); }

.hero p {
  color:#999;
  max-width:510px;
  line-height:1.9;
  font-size:14px;
}

.hero-buttons {
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-top:28px;
}

.primary-btn,
.secondary-btn {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:7px;
  padding:13px 19px;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
  transition:.25s;
}

.primary-btn {
  background:var(--red);
  color:white;
  border:1px solid var(--red);
}

.primary-btn:hover {
  background:#c91c24;
  transform:translateY(-2px);
}

.secondary-btn {
  border:1px solid #444;
  color:white;
  background:#141414;
}

.secondary-btn:hover {
  border-color:var(--gold);
  color:var(--gold);
}

.hero-visual {
  min-height:235px;
  border:1px solid #402123;
  border-radius:15px;
  background:
    radial-gradient(circle at 50% 45%,#ed252d23,transparent 65%),
    linear-gradient(145deg,#191010,#0c0c0c);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:25px;
}

.hero-ball {
  font-size:74px;
  filter:drop-shadow(0 0 20px #ed252d50);
  margin-bottom:15px;
}

.hero-visual strong {
  font-family:Orbitron,sans-serif;
  font-size:18px;
}

.hero-visual small {
  color:var(--gold);
  margin-top:10px;
  letter-spacing:2px;
  font-size:10px;
}

/* MAIN */

main {
  min-height:650px;
  padding:40px 0 70px;
}

.page {
  display:none;
  animation:show .3s ease;
}

.page.active { display:block; }

@keyframes show {
  from {opacity:0;transform:translateY(8px)}
  to {opacity:1;transform:translateY(0)}
}

.section-heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:25px;
}

.section-heading h2 {
  font-family:Orbitron,sans-serif;
  font-size:21px;
}

.section-heading h2 span { color:var(--red); }

.section-heading p {
  color:var(--muted);
  font-size:11px;
  margin-top:7px;
}

.section-label {
  color:var(--gold);
  font-size:10px;
  letter-spacing:2px;
  font-weight:800;
  margin-bottom:8px;
}

/* COMPETITION CARDS */

.competition-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:20px;
  margin-bottom:35px;
}

.competition-card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:12px;
  overflow:hidden;
  transition:.25s;
}

.competition-card:hover {
  border-color:#703034;
  transform:translateY(-3px);
}

.competition-top {
  padding:19px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  border-bottom:1px solid var(--border);
}

.competition-name {
  display:flex;
  align-items:center;
  gap:12px;
}

.competition-icon {
  width:43px;
  height:43px;
  display:grid;
  place-items:center;
  background:#1b1515;
  border-radius:10px;
  font-size:23px;
}

.competition-name h3 { font-size:13px; }

.competition-name p {
  color:var(--muted);
  font-size:10px;
  margin-top:5px;
}

.live-label {
  color:#ff5d64;
  font-size:10px;
  font-weight:800;
}

.iframe-wrap {
  width:100%;
  padding:10px;
  background:#0c0c0c;
}

.iframe-wrap iframe {
  display:block;
  width:100%;
  height:390px;
  border:0;
  border-radius:7px;
  background:#111;
}

.frame-caption {
  color:#777;
  font-size:10px;
  padding:10px 17px 15px;
}

/* STANDINGS */

.table-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:20px;
}

.table-card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:12px;
  overflow:hidden;
}

.table-card h3 {
  padding:18px;
  font-size:13px;
  border-bottom:1px solid var(--border);
}

.footyaro-table {
  padding:12px;
  min-height:300px;
  overflow:auto;
}

.footyaro-table iframe {
  max-width:100%;
}

/* FIXTURES */

.fixtures-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:20px;
}

.info-card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:12px;
  overflow:hidden;
}

.info-card h3 {
  padding:18px;
  font-size:13px;
  border-bottom:1px solid var(--border);
}

.info-card .iframe-wrap iframe { height:420px; }

/* BARCELONA */

.barca-card {
  background:
    linear-gradient(120deg,#1c1014,#101010 65%);
  border:1px solid #53202b;
  border-radius:13px;
  padding:30px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.barca-card h2 {
  font-family:Orbitron,sans-serif;
  font-size:25px;
}

.barca-card p {
  color:#999;
  font-size:12px;
  line-height:1.8;
  margin-top:10px;
}

.barca-symbol {
  font-size:65px;
}

/* NEWS */

.news-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.news-card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:10px;
  padding:22px;
}

.news-card .tag {
  color:var(--gold);
  font-size:10px;
  letter-spacing:2px;
  font-weight:800;
}

.news-card h3 {
  font-size:15px;
  margin:14px 0 9px;
}

.news-card p {
  color:#888;
  font-size:12px;
  line-height:1.8;
}

/* FOOTER */

footer {
  border-top:1px solid var(--border);
  padding:35px 0;
  background:#080808;
}

.footer-inner {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.footer-logo {
  font-family:Orbitron,sans-serif;
  font-size:16px;
  font-weight:800;
}

.footer-logo span { color:var(--red); }

footer p {
  color:#777;
  font-size:11px;
  line-height:1.8;
}

.footer-links {
  display:flex;
  gap:17px;
  flex-wrap:wrap;
}

.footer-links button {
  background:none;
  border:0;
  color:#888;
  cursor:pointer;
  font-size:11px;
}

.footer-links button:hover { color:var(--red); }

/* RESPONSIVE */

@media(max-width:850px) {
  .header-inner {
    flex-wrap:wrap;
    padding:13px 0;
  }

  nav {
    order:3;
    width:100%;
    overflow-x:auto;
  }

  .nav-btn { white-space:nowrap; }

  .hero-content { grid-template-columns:1fr; }

  .hero-visual { min-height:190px; }
}

@media(max-width:600px) {
  .competition-grid,
  .table-grid,
  .fixtures-grid,
  .news-grid {
    grid-template-columns:1fr;
  }

  .hero { padding:50px 0; }

  .hero h1 { letter-spacing:-1px; }

  .section-heading h2 { font-size:17px; }

  .iframe-wrap iframe { height:360px; }

  .barca-card {
    flex-direction:column;
    align-items:flex-start;
  }

  .header-live { font-size:9px; }

  .logo { font-size:16px; }
}

@media(max-width:350px) {
  .logo { font-size:13px; }
  .nav-btn { padding:10px 9px; }
}
</style>
</head>

